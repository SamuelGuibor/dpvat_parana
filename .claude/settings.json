{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["crm-op"],
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx knip*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma migrate diff *)",
      "Bash(npx prisma migrate status*)",
      "Bash(node --check *)",
      "Bash(wc *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(npx tsc --noEmit*)",
      "PowerShell(npm test*)",
      "PowerShell(npm run lint*)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx eslint *)",
      "PowerShell(npx prisma validate*)",
      "PowerShell(npx prisma migrate diff *)",
      "PowerShell(npx prisma migrate status*)",
      "mcp__crm-op__diagnostico_crm",
      "mcp__crm-op__buscar_cliente",
      "mcp__crm-op__obter_card",
      "mcp__crm-op__listar_historico",
      "mcp__crm-op__listar_documentos",
      "mcp__crm-op__listar_colunas",
      "mcp__crm-op__listar_tags",
      "mcp__crm-op__listar_cards_parados",
      "mcp__crm-op__listar_cards_coluna",
      "mcp__crm-op__verificar_pendencias",
      "mcp__crm-op__consultar_conversa",
      "mcp__crm-op__consultar_hospital",
      "mcp__crm-op__minhas_permissoes",
      "mcp__crm-op__meu_dia",
      "mcp__crm-op__listar_modelos",
      "mcp__crm-op__quem_pediu",
      "mcp__crm-op__analisar_documentos",
      "mcp__crm-op__panorama_card",
      "mcp__crm-op__iniciar_lote",
      "mcp__crm-op__resultado_lote",
      "mcp__crm-op__gerar_relatorio",
      "mcp__crm-op__varrer_inconsistencias",
      "mcp__crm-op__fluxos_abertos",
      "mcp__crm-op__retomar_fluxo",
      "mcp__crm-op__salvar_progresso",
      "mcp__crm-op__preparar_procuracao",
      "mcp__crm-op__preparar_pedido_prontuario",
      "mcp__crm-op__preparar_contrato",
      "mcp__crm-op__mover_card",
      "mcp__crm-op__adicionar_tag",
      "mcp__crm-op__remover_tag",
      "mcp__crm-op__comentar_card",
      "mcp__crm-op__notificar_pessoa",
      "mcp__crm-op__arquivar_card",
      "mcp__crm-op__anexar_rascunho",
      "mcp__crm-op__editar_cadastro",
      "mcp__crm-op__gerenciar_documento",
      "mcp__crm-op__editar_comentario",
      "mcp__crm-op__atualizar_tarefa",
      "mcp__crm-op__preparar_email",
      "mcp__crm-op__preparar_whatsapp",
      "Read(//d/Chatbot_whatsapp/**)",
      "Read(//d/docx-converter/**)"
    ],
    "deny": [
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate reset*)",
      "PowerShell(npx prisma migrate dev*)",
      "PowerShell(npx prisma migrate reset*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-env.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.mjs\"", "timeout": 10 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/op-prompt.mjs\"", "timeout": 8 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__crm-op__.*",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/op-tool.mjs\"", "timeout": 8 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/op-response.mjs\"", "timeout": 8 }]
      },
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-typecheck.mjs\"", "timeout": 180 }]
      }
    ]
  }
}
