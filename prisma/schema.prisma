generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime usa o endpoint POOLED do Neon (conexões rápidas e estáveis);
  // o Prisma CLI (migrations) usa a conexão direta via DIRECT_URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SavedPrompt {
  id        String   @id @default(cuid())
  title     String
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Config das mensagens automáticas de PROGRESSÃO DE STATUS enviadas ao cliente
// no WhatsApp. Uma linha por (serviceKey, status) — global, não por card.
// customText nulo = usa o texto padrão do sistema; enabled=false = não envia.
// serviceKey é normalizado: "DPVAT" | "INSS" | "GENERIC".
model StatusMessageConfig {
  id         String   @id @default(cuid())
  serviceKey String
  status     String
  enabled    Boolean  @default(true)
  customText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([serviceKey, status])
  @@map("status_message_configs")
}

model User {
  id                  String         @id @default(cuid())
  name                String?
  cpf                 String?
  email               String         @unique
  password            String?
  rua                 String?
  bairro              String?
  numero              String?
  cep                 String?
  image               String?
  role                String         @default("Filtro de Cartões")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  emailVerified       DateTime?
  cidade              String?
  estado              String?
  estado_civil        String?
  nacionalidade       String?
  nome_mae            String?
  profissao           String?
  rg                  String?
  status              String?
  telefone            String?
  atendimento_via     String?
  hospital            String?
  lesoes              String?
  outro_hospital      String?
  cpf_res             String?
  estado_civil_res    String?
  nome_res            String?
  profissao_res       String?
  rg_res              String?
  statusStartedAt     DateTime?
  obs                 String?
  service             String?
  otherObs            String?
  fixed               Boolean?       @default(true)
  roleFixed           String?        @default("Acompanhamento de fluxo 1")
  labelId             String?
  apto                Boolean        @default(false)
  data_nasc           String?
  data_acidente       String?
  senha_inss          String?
  cardNumber          Int?           @unique
  afastadoAte         DateTime?
  afastadoNotificado  Boolean        @default(false)
  lastSeenAt          DateTime?
  telefone_secundario String?
  rede_social         String?
  archiveStatus       String?
  archivedAt          DateTime?
  boardOrder          Int?
  permissions         Json?
  // Progresso do tutorial de onboarding: { dash: { step, done }, client: { step, done } }
  onboarding          Json?
  // Jornada esperada no controle de ponto: { dailyMinutes: 480, days: [1,2,3,4,5] }
  workSchedule        Json?
  sectorId            String?
  sector              Sector?        @relation("UserSector", fields: [sectorId], references: [id], onDelete: SetNull)
  accounts            Account[]
  commentsAsAuthor    Comment[]      @relation("CommentAuthor")
  commentsOnCard      Comment[]      @relation("UserComments")
  document            Document[]
  notifications       Notification[] @relation("UserNotifications")
  mentions            Mention[]      @relation("UserMentions")
  processes           Process[]
  sessions            Session[]
  label               Label?         @relation("UserLabel", fields: [labelId], references: [id])
  chatMessages        ChatMessage[]  @relation("ChatAuthor")
  chatReactions       ChatReaction[] @relation("ReactionAuthor")
  logs                Log[]          @relation("UserLogs")
  cardTags            CardTag[]      @relation("UserCardTags")
}

// Setor/função da pessoa (Comercial, Financeiro, Desenvolvedor…). Diferente de
// `role` (nível de acesso): o setor é a "área" da pessoa, usada para @menção no
// chat, tag no perfil e dashboard de rendimento por setor. Quem pode gerir os
// setores é controlado por SECTOR_ADMIN_IDS (ver app/_shared/lib/sector-admin.ts).
model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  // slug em minúsculas, sem espaço — é o que se digita no @menção (@comercial).
  slug      String   @unique
  color     String   @default("#3b82f6")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]   @relation("UserSector")

  @@map("sectors")
}

// Aviso urgente do time de DESENVOLVIMENTO para a equipe online (ex.: "dê F5,
// saiu atualização"). type="popup" aparece como modal para quem estiver com o
// painel aberto (poll no UserMenu); expira em poucas horas para quem logar
// depois não ver aviso velho. type="notification" nem passa por aqui — vira
// Notification comum no sino.
model DevAlert {
  id         String   @id @default(cuid())
  title      String?
  message    String
  authorId   String
  authorName String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@map("dev_alerts")
}

// Código de recuperação de senha da área do cliente (enviado por SMS/WhatsApp
// ao telefone cadastrado). Um código por vez por usuário; expira em minutos.
model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String    @unique
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("password_reset_codes")
}

model ChatMessage {
  id             String         @id @default(cuid())
  body           String
  authorId       String
  authorName     String
  channelId      String
  createdAt      DateTime       @default(now())
  editedAt       DateTime?
  // Soft-delete estilo WhatsApp: quando preenchido, renderiza "mensagem apagada".
  deletedAt      DateTime?
  // Resposta a outra mensagem (reply). Guarda também um snapshot do original
  // (autor + trecho) para render estável mesmo se o pai for alterado/apagado.
  replyToId      String?
  replyToAuthor  String?
  replyToBody    String?
  // Anexo opcional (foto/vídeo/áudio/arquivo). A key aponta pro S3 (prefixo
  // "chat/"); o tipo MIME decide o render inline (imagem/vídeo/áudio) ou link.
  attachmentKey  String?
  attachmentName String?
  attachmentType String?
  author         User           @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replyTo        ChatMessage?   @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]  @relation("ChatReply")
  reactions      ChatReaction[]

  @@index([channelId, createdAt])
  @@map("chat_messages")
}

// Reação (emoji) de uma pessoa numa mensagem. Unicidade por (msg, user, emoji)
// permite alternar (toggle): reagir de novo com o mesmo emoji remove.
model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  userName  String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation("ReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

model ChatRead {
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  @@id([userId, channelId])
  @@map("chat_reads")
}

// Canal customizado (privado por natureza): só os membros veem/escrevem.
// Os canais "general" e "dm:*" NÃO têm linha aqui — são tratados por convenção.
model ChatChannel {
  id          String              @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime            @default(now())
  // "Modo aviso": quando true, só o dono (createdById) pode enviar mensagens —
  // os demais membros só leem (tipo mural/anúncios). Alternável só pelo dono.
  announceOnly Boolean            @default(false)
  members     ChatChannelMember[]

  @@map("chat_channels")
}

model ChatChannelMember {
  channelId String
  userId    String
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
  @@map("chat_channel_members")
}

model Process {
  id                  String     @id @default(cuid())
  userId              String
  role                String?
  statusStartedAt     DateTime?
  atendimento_via     String?
  hospital            String?
  outro_hospital      String?
  lesoes              String?
  type                String?
  observacao          String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  status              String?
  bairro              String?
  cep                 String?
  cidade              String?
  cpf                 String?
  cpf_res             String?
  email               String?
  emailVerified       DateTime?
  estado              String?
  estado_civil        String?
  estado_civil_res    String?
  image               String?
  nacionalidade       String?
  name                String?
  nome_mae            String?
  nome_res            String?
  numero              String?
  profissao           String?
  profissao_res       String?
  rg                  String?
  rg_res              String?
  rua                 String?
  telefone            String?
  otherObs            String?
  service             String?
  fixed               Boolean?   @default(true)
  roleFixed           String?    @default("Acompanhamento de fluxo 1")
  labelId             String?
  data_nasc           String?
  data_acidente       String?
  senha_inss          String?
  cardNumber          Int?       @unique
  afastadoAte         DateTime?
  afastadoNotificado  Boolean    @default(false)
  telefone_secundario String?
  rede_social         String?
  archiveStatus       String?
  archivedAt          DateTime?
  boardOrder          Int?
  commentsOnProcess   Comment[]  @relation("ProcessComments")
  documents           Document[]
  label               Label?     @relation("ProcessLabel", fields: [labelId], references: [id])
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs                Log[]      @relation("ProcessLogs")
  cardTags            CardTag[]  @relation("ProcessCardTags")
}

// Tag livre dos CARDS do kanban (diferente de Label = coluna e de WhatsAppTag
// = tag de conversa). Aparece no card ao lado do badge de serviço; criada e
// gerenciada de dentro do diálogo do card. Many-to-many com User e Process
// (os dois tipos de card).
model CardTag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())
  users     User[]    @relation("UserCardTags")
  processes Process[] @relation("ProcessCardTags")

  @@map("card_tags")
}

model Label {
  id            String       @id @default(cuid())
  name          String       @unique
  color         String
  order         Int          @default(0)
  timeLimitDays Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  processes     Process[]    @relation("ProcessLabel")
  users         User[]       @relation("UserLabel")
  automations   Automation[]
}

model Automation {
  id             String   @id @default(cuid())
  name           String
  isActive       Boolean  @default(true)
  triggerLabelId String
  cardType       String   @default("both")
  conditionLogic String   @default("AND")
  conditions     Json     @default("[]")
  actions        Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  triggerLabel   Label    @relation(fields: [triggerLabelId], references: [id], onDelete: Cascade)

  @@map("automations")
}

model Comment {
  id         String   @id @default(cuid())
  text       String
  authorId   String?
  authorName String
  userId     String?
  processId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  targetName String
  author     User?    @relation("CommentAuthor", fields: [authorId], references: [id])
  process    Process? @relation("ProcessComments", fields: [processId], references: [id])
  user       User?    @relation("UserComments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([processId])
  @@index([authorId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Message {
  id               String       @id @default(cuid())
  titulo           String
  role             String       @default("USER")
  createdAt        DateTime?    @default(now())
  updatedAt        DateTime?    @updatedAt
  multipleMessages SubMessage[]
}

model SubMessage {
  id        String    @id @default(cuid())
  conteudo  String
  messageId String
  mediaType String?
  mediaUrl  String?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Document {
  id         String    @id @default(uuid())
  userId     String
  key        String
  name       String
  // Ordem manual na aba Arquivos (menor = mais acima); null = ordem de criação.
  sortOrder  Int?
  uploadedAt DateTime  @default(now())
  processId  String?
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
  process    Process?  @relation(fields: [processId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String    @id @default(uuid())
  name      String
  number    String
  desc      String?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  authorId    String
  authorName  String
  message     String
  commentId   String?
  userId      String?
  processId   String?
  // Notificações de WhatsApp (bot/handoff): clicar abre direto a conversa.
  contactId   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  targetName  String
  recipient   User     @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
}

// Caixa de menções e tarefas. Cada @menção (comentário de card ou chat da
// equipe) vira uma linha aqui, com estado próprio: PENDING → ACK (tomei
// ciência) → DONE (resolvi). Existe separada da Notification porque o sino é
// volátil — o usuário limpa e perde a rastreabilidade de "de onde era".
model Mention {
  id            String    @id @default(cuid())
  recipientId   String
  authorId      String?
  authorName    String
  // "comment" (comentário de card) | "chat" (chat da equipe)
  source        String    @default("comment")
  // Trecho já limpo do markup de menção/negrito, para render na tabela.
  excerpt       String
  // Origem — comentário de card (userId/processId é o card a abrir)
  commentId     String?
  userId        String?
  processId     String?
  // Nome do card ou do canal, para o usuário saber de onde veio.
  targetName    String
  // Origem — chat da equipe
  chatMessageId String?
  channelId     String?
  // PENDING | ACK | DONE
  status        String    @default("PENDING")
  ackAt         DateTime?
  doneAt        DateTime?
  createdAt     DateTime  @default(now())
  recipient     User      @relation("UserMentions", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([recipientId, createdAt])
  @@map("mentions")
}

model Log {
  id         String   @id @default(cuid())
  action     String
  message    String
  authorId   String
  authorName String
  userId     String?
  processId  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  process    Process? @relation("ProcessLogs", fields: [processId], references: [id], onDelete: Cascade)
  user       User?    @relation("UserLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([processId])
  @@index([action, createdAt])
  @@map("logs")
}

// Meta mensal do escritório (ex.: contratos fechados no mês) — alimenta o
// card "Meta do mês" da Gestão Estratégica. month no formato "YYYY-MM".
model Goal {
  id        String   @id @default(cuid())
  month     String
  metric    String   @default("contratos")
  target    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, metric])
  @@map("goals")
}

// ============ WhatsApp Cloud API (Meta oficial) ============

// NÚMERO da empresa (multi-tenant, 07/08/2026): cada linha é um número do
// WhatsApp Business com suas próprias credenciais da Meta, cadastradas pela
// tela de Números do workspace. O token vai CRIPTOGRAFADO (AES-256-GCM em
// app/_shared/lib/whatsapp/crypto.ts) — nunca em texto puro no banco.
// Enquanto não houver linha aqui, o sistema segue nas envs WHATSAPP_* (o
// runtime cria/casa o número default automaticamente — ver numbers.ts).
model WhatsAppNumber {
  id             String   @id @default(cuid())
  phoneNumberId  String   @unique // id do número na Meta (metadata.phone_number_id do webhook)
  wabaId         String? // conta WhatsApp Business dona do número (templates são por WABA)
  displayPhone   String? // E.164 exibido (display_phone_number)
  label          String // nome amigável na UI ("Comercial PR", "Leads Meta Ads"...)
  accessTokenEnc String // token de System User, criptografado
  appSecretEnc   String? // app secret p/ HMAC do webhook (null = usa WHATSAPP_APP_SECRET global)
  apiVersion     String   @default("v21.0")
  active         Boolean  @default(true)
  // O número "original" (fallback de envio quando a conversa não tem numberId).
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("whatsapp_numbers")
}

// Contato = número de telefone único POR NÚMERO DA EMPRESA (o mesmo cliente
// pode conversar com dois números nossos — são atendimentos separados). Pode
// ser vinculado manualmente a um User/Process já cadastrado (userId/processId
// são referências soltas, sem FK, para não criar cascade com dados de
// clientes).
model WhatsAppContact {
  id             String                @id @default(cuid())
  phone          String // E.164, ex: 5541999999999
  // Número da empresa que atende este contato. Null só em linha legada ainda
  // não backfillada (o ingest "adota" a linha na primeira mensagem nova).
  numberId       String?
  name           String?
  userId         String?
  processId      String?
  optedOut       Boolean               @default(false)
  // Opt-in documentado (exigência anti-spam da Meta): quando e como o cliente
  // aceitou receber mensagens. Preenchido automaticamente na 1ª mensagem
  // recebida ("inbound"). Sem opt-in, envio proativo fora da janela de 24h é
  // pulado (dentro da janela sempre pode, pois o cliente acabou de escrever).
  optedInAt      DateTime?
  optInSource    String? // inbound | manual
  // Rascunho da ficha do cliente preenchida no atendimento, quando o contato
  // ainda não tem User vinculado. Vira User no "Adicionar cliente".
  clientDraft    Json?
  // Documentos pessoais anexados na ficha antes do contato virar cliente:
  // [{ key, name, uploadedAt }]. Migram para Document real no "Adicionar cliente".
  draftDocuments Json?
  // Atribuição de origem (Click-to-WhatsApp ads): preenchido na PRIMEIRA
  // mensagem que chega com objeto `referral` da Meta e nunca sobrescrito
  // (first touch). adPlatform é derivado da source_url (facebook | instagram).
  adPlatform     String?
  adSourceType   String? // ad | post | page
  adSourceId     String? // ID do anúncio/post na Meta
  adSourceUrl    String?
  adHeadline     String?
  ctwaClid       String? // click id p/ API de Conversões
  adReferral     Json? // payload cru do referral, para auditoria
  // Ficha por IA: quais campos foram preenchidos pela IA (e quando) —
  // { "cidade": "2026-08-06T22:10:00.000Z" }. Serve só para marcar a origem na
  // ficha; quando um humano edita o campo, a marca sai.
  aiFilledFields Json?
  // Hospital citado pelo cliente. A IA NUNCA preenche o campo hospital (é um
  // select com cadastro próprio) — deixa a dica aqui para o atendente escolher
  // a opção certa na mão.
  hospitalHint   String?
  // Último estágio do funil reportado à API de Conversões da Meta (dedupe:
  // não reenvia o mesmo estágio pro mesmo lead). Ex.: LeadQualificado.
  metaLeadStage   String?
  metaLeadStageAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  conversation   WhatsAppConversation?
  messages       WhatsAppMessage[]

  @@unique([numberId, phone])
  @@index([phone])
  @@map("whatsapp_contacts")
}

model WhatsAppConversation {
  id              String                     @id @default(cuid())
  contactId       String                     @unique
  // Denormalizado do contato (o dashboard filtra conversas por número direto).
  numberId        String?
  // "standby" (28/07/2026): cliente sumiu no meio da triagem — em vez de
  // fechar, entra no ciclo de recuperação (até 3 provocações em ~3 dias).
  status          String                     @default("bot") // bot | queued | human | standby | closed
  assignedToId    String?
  // Só relevante quando status="closed": null/false = não qualificada
  // (default), true = qualificada. Decidido no botão de encerrar ou pela IA.
  qualified       Boolean?
  // Desfecho do atendimento (categoria de encerramento decidida pela IA ou
  // pelo atendente): qualificado | nao_qualificado | perguntas | novo_acidente
  // | transferido | sem_resposta (esgotou o ciclo de recuperação sem retorno).
  // Null enquanto em andamento.
  closeCategory   String?
  // Ciclo de RECUPERAÇÃO (status "standby"): provocações enviadas pelo cron
  // pra resgatar quem sumiu no meio da triagem. O contador NÃO zera quando o
  // cliente responde (pausa e retoma se ele sumir de novo); só zera no
  // desfecho real (qualificou/encerrou). Máx. 3 tentativas.
  recoveryAttempts Int                       @default(0)
  recoveryNextAt   DateTime? // quando o cron pode disparar a próxima provocação
  recoveryOutcome  String? // recuperado | esgotado | opt_out (último desfecho do ciclo)
  // Cérebro da IA (persistido por conversa; o microserviço é stateless):
  botMemory       String? // ficha de fatos extraída pela IA ("Nome: João | Cidade: Curitiba")
  botState        String? // etapa da conversa (triagem_seguro, coleta_cpf...)
  botFailCount    Int                        @default(0) // "não entendi" seguidos; 2 → escala pra humano
  botNudge30At    DateTime? // "ainda está aí?" enviado (silêncio de 30min)
  botNudge24At    DateTime? // follow-up de ~24h enviado
  // Urgência detectada pela IA — destaca a conversa no inbox até um atendente
  // assumir ou encerrar.
  urgent          Boolean                    @default(false)
  // SLA da fila de espera: quando entrou na fila e quando o último alerta de
  // "cliente esperando demais" foi disparado pelo cron (evita spam).
  queuedAt        DateTime?
  queueAlertAt    DateTime?
  // Último alerta de FALHA DE ENTREGA (status "failed" da Meta ou mensagem
  // parada em "sent" sem "delivered" = provável bloqueio/número errado) —
  // debounce para não repetir o aviso. O envio ao número NÃO é bloqueado:
  // a equipe é avisada para verificar número/bloqueio/janela de 24h.
  deliveryAlertAt DateTime?
  lastMessageAt   DateTime                   @default(now())
  // Legado: marcador global de leitura (mantido como fallback na migração
  // para leitura POR ATENDENTE — ver WhatsAppConversationRead).
  lastReadAt      DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  contact         WhatsAppContact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tags            WhatsAppConversationTag[]
  reads           WhatsAppConversationRead[]

  @@index([status])
  @@index([assignedToId])
  @@index([numberId, lastMessageAt])
  @@map("whatsapp_conversations")
}

// Leitura POR ATENDENTE: cada membro da equipe tem seu próprio "até onde li"
// em cada conversa — abrir a conversa não zera o não-lido dos colegas.
model WhatsAppConversationRead {
  conversationId String
  userId         String
  lastReadAt     DateTime             @default(now())
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("whatsapp_conversation_reads")
}

// Respostas rápidas (snippets) do atendimento — textos curtos reutilizáveis
// que o atendente insere no composer com um clique.
model WhatsAppQuickReply {
  id        String   @id @default(cuid())
  title     String   @unique
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_quick_replies")
}

// Tags livres pra organizar conversas (ex.: "Urgente", "VIP", "Recontato").
model WhatsAppTag {
  id            String                    @id @default(cuid())
  name          String                    @unique
  color         String                    @default("#10b981")
  createdAt     DateTime                  @default(now())
  conversations WhatsAppConversationTag[]

  @@map("whatsapp_tags")
}

// Sub-motivos de "não qualificado" editáveis pela equipe (menu Encerrar).
// A key vira o closeCategory da conversa (sempre com prefixo "nq_", que é o
// que marca qualified=false); apagar um motivo NÃO mexe nas conversas já
// encerradas com ele — o rótulo salvo continua resolvível pelo histórico.
model WhatsAppCloseReason {
  id        String   @id @default(cuid())
  key       String   @unique // ex.: nq_sem_fratura
  label     String // ex.: "Não qualificada — sem fratura"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("whatsapp_close_reasons")
}

model WhatsAppConversationTag {
  conversationId String
  tagId          String
  // Quando a tag foi aplicada (03/08/2026). Sem isto não dava para dizer
  // "quantos contratados NESTE mês" — a contagem era só um total geral, que
  // inflaria a meta mensal para sempre. Linhas antigas herdaram a data da
  // migration, então histórico anterior a 03/08/2026 não é recuperável.
  createdAt      DateTime             @default(now())
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            WhatsAppTag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("whatsapp_conversation_tags")
}

model WhatsAppMessage {
  id               String          @id @default(cuid())
  contactId        String
  // Denormalizado do contato — as agregações do Desempenho do Chatbot filtram
  // mensagens por número sem join.
  numberId         String?
  waMessageId      String?         @unique // id da Meta; evita duplicar em retry de webhook
  direction        String // in | out
  body             String?
  mediaKey         String? // chave no S3 (mesmo bucket dos documentos)
  mediaType        String?
  status           String          @default("sent") // sent | delivered | read | failed
  sentByBot        Boolean         @default(false)
  // Origem de mensagem PROATIVA do sistema ("automation" | "progress").
  // Null em respostas do bot conversacional e de atendentes. Usado pelo cap
  // de frequência anti-spam (máx. 1 proativa por contato a cada N horas).
  systemSource     String?
  authorId         String? // funcionário que enviou (se humano)
  internal         Boolean         @default(false) // nota interna, não vai pro cliente
  // Edição/exclusão LOCAIS (a Cloud API não propaga pro celular do cliente).
  editedAt         DateTime?
  deletedAt        DateTime?
  // Resposta (quote): id da mensagem respondida + snapshot pro render estável.
  replyToId        String?
  replyToBody      String?
  replyToDirection String?
  // Transcrição de áudio feita a pedido do atendente (botão "transcrever").
  // Persistida: o próximo clique (de qualquer atendente) não paga IA de novo.
  transcript       String?
  createdAt        DateTime        @default(now())
  contact          WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([numberId, createdAt])
  @@map("whatsapp_messages")
}

// Fluxo de mensagens pré-setadas do atendimento (sequência de textos com
// delay entre os envios). steps = [{ body: string, delayMs: number }].
model WhatsAppFlow {
  id          String   @id @default(cuid())
  name        String   @unique
  // Descrição do fluxo em linguagem natural — a IA lê isto para decidir QUANDO
  // este fluxo se encaixa na situação do cliente e dispará-lo automaticamente.
  description String?
  steps       Json
  // IDs de WhatsAppTag aplicadas ao contato quando o fluxo é disparado
  // (organização do chat: ex. fluxo de dispensa já etiqueta o cliente).
  tagIds      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("whatsapp_flows")
}

// CÉREBRO DA IA — fila de revisão humana dos atendimentos encerrados.
//
// Toda conversa encerrada vira um SNAPSHOT imutável no S3 (thread completa +
// ficha + desfecho) e uma linha aqui, que é o ÍNDICE: permite listar, filtrar e
// ordenar a fila sem ler o S3. O julgamento humano (aprovado/reprovado + o que
// faltou) é o que, mais tarde, será destilado no playbook injetado no prompt do
// bot — ver app/_shared/lib/whatsapp/brain.ts.
model WhatsAppReview {
  id             String    @id @default(cuid())
  contactId      String
  conversationId String?
  // Ponteiro para o snapshot imutável no S3 (fonte da verdade do conteúdo).
  s3Key          String    @unique
  // ---- Metadados copiados do snapshot (para filtrar/ordenar sem ler o S3) ---
  contactName    String?
  contactPhone   String
  closeCategory  String?
  qualified      Boolean?
  // Como o atendimento terminou: bot_disqualify | bot_resolve | cron_silencio |
  // manual. Diz se quem decidiu foi a IA ou um humano.
  closedReason   String
  messageCount   Int       @default(0)
  // false = um atendente assumiu em algum momento (a conversa não é 100% da IA).
  botOnly        Boolean   @default(true)
  // ---- Julgamento humano ---------------------------------------------------
  status         String    @default("pendente") // pendente | revisado
  verdict        String? // aprovado | parcial | reprovado
  comment        String? // o que faltou / por que estava correto
  errorTags      String[]  @default([])
  // "Era assim que devia ter respondido" — o campo mais valioso para treino.
  correctReply   String?
  reviewerId     String?
  reviewerName   String?
  reviewedAt     DateTime?
  // ---- Lição destilada (passo A do cérebro) --------------------------------
  // Extraída pela IA logo após o julgamento: o comentário livre do supervisor
  // vira uma regra curta e generalizável. Vazia/nula é resultado LEGÍTIMO —
  // aprovação sem nada notável não deve virar regra (encheria o playbook de
  // obviedade). O supervisor pode corrigir o texto na tela.
  lesson         String?
  // Etapas da conversa em que a lição se aplica (triagem_seguro, coleta_cpf...).
  // É por aqui que a busca de exemplos por estado vai funcionar, sem embeddings.
  lessonStates   String[]  @default([])
  // Seção do playbook: QUALIFICACAO | CONTEXTO | TOM | INFORMACAO |
  // ENCAMINHAMENTO | RITMO | OUTRO.
  lessonSection  String?
  // true quando o humano reescreveu a lição — sinal de que a extração errou,
  // útil para calibrar o prompt de destilação depois.
  lessonEdited   Boolean   @default(false)
  // ---- Autonomia futura ----------------------------------------------------
  // Pré-veredito sugerido pela própria IA (fase 5). Nulo enquanto a revisão for
  // 100% manual — o humano continua sendo quem decide.
  aiSuggestedVerdict String?
  aiSuggestedReason  String?
  // Marca quando esta review já foi absorvida por uma versão do playbook.
  distilledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([contactId])
  @@index([distilledAt])
  @@map("whatsapp_reviews")
}

// PLAYBOOK — camada 3 do cérebro: as regras destiladas que entram no system
// prompt do bot em TODA conversa.
//
// Versionado e imutável: cada consolidação cria uma versão nova em "rascunho",
// o supervisor compara com a publicada e decide. Nada vai pro prompt sem
// aprovação humana (decisão do Samuel, 23/07/2026).
//
// Por que versionar em vez de sobrescrever: publicar um playbook novo invalida
// o cache de prompt da Anthropic (o bloco deixa de ser byte-a-byte idêntico).
// Versão explícita permite publicar em lote, uma vez por dia, em vez de a cada
// revisão salva — e permite voltar atrás se uma versão piorar o bot.
model WhatsAppPlaybook {
  id          String    @id @default(cuid())
  version     Int       @unique
  // sections: [{ name, rules: [{ text, weight, states[] }] }]
  sections    Json
  rulesCount  Int       @default(0)
  // Resumo do que mudou em relação à versão anterior (escrito pela IA).
  changeNote  String?
  status      String    @default("rascunho") // rascunho | publicado | descartado
  // Quantas reviews sustentam esta versão.
  reviewCount Int       @default(0)
  // IDs das WhatsAppReview cujas lições ENTRARAM nesta consolidação. O publish
  // marca distilledAt SÓ nesta lista — antes marcava todas as pendentes, e
  // lições além do teto de 200 (ou revisadas entre gerar o rascunho e aprovar)
  // eram dadas como absorvidas sem nunca entrar em playbook nenhum.
  reviewIds   String[]  @default([])
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime  @default(now())

  @@index([status, version])
  @@map("whatsapp_playbooks")
}

// EVENTOS DE REGRA — telemetria do playbook: uma linha cada vez que a IA
// declara que uma regra aprendida influenciou a resposta (kind="rule"), ou que
// o cron decidiu contextualmente cutucar/encerrar uma conversa silenciosa
// (kind="followup"). Alimenta a aba "Métricas" da Revisão da IA: quais regras
// realmente trabalham, em quais conversas, com que resultado.
//
// ruleText/section são SNAPSHOT no momento do uso — o playbook é versionado e a
// numeração R1..Rn muda a cada publicação, então o evento guarda o texto que
// valia na hora, não um ponteiro que apodrece.
model WhatsAppRuleEvent {
  id              String   @id @default(cuid())
  kind            String   @default("rule") // rule | followup | recovery
  // Número da empresa da conversa (métricas por número no dashboard).
  numberId        String?
  // kind="rule": ID da regra na versão vigente (R1, R2...). kind="recovery":
  // marcador da tentativa (T1, T2, T3). Nulo em followup.
  ruleId          String?
  ruleText        String?
  section         String?
  playbookVersion Int?
  contactId       String
  contactName     String?
  botState        String?
  // kind="rule": ação da decisão (continue/qualify/...). kind="followup":
  // nudge | close. kind="recovery": attempt | recovered | exhausted | opt_out.
  action          String?
  // kind="rule": trecho da resposta enviada. kind="followup": motivo da decisão da IA.
  detail          String?
  createdAt       DateTime @default(now())

  @@index([kind, createdAt])
  @@index([ruleId, createdAt])
  @@index([contactId])
  @@index([numberId, createdAt])
  @@map("whatsapp_rule_events")
}

// INSTRUÇÕES BASE do bot — o que era o STATIC_SYSTEM_PROMPT hardcoded no
// bot.js, agora estruturado em seções editáveis pela tela.
//
// Diferença para WhatsAppPlaybook: aqui é o que VOCÊ escreve (identidade,
// roteiro, regras de negócio); lá é o que a IA APRENDE das suas revisões. Os
// dois entram no system prompt, em blocos separados, e são versionados do
// mesmo jeito — rascunho → publicado → S3 → microserviço.
//
// O microserviço mantém o texto hardcoded como FALLBACK: se este registro
// sumir ou a rota falhar, o bot continua atendendo com o prompt original em
// vez de ficar sem instrução nenhuma.
model WhatsAppInstructions {
  id          String    @id @default(cuid())
  version     Int       @unique
  // Texto de abertura, antes da primeira seção (identidade e tom do bot).
  intro       String
  // sections: [{ id, title, content, order, enabled }]
  sections    Json
  status      String    @default("rascunho") // rascunho | publicado | descartado
  changeNote  String?
  charCount   Int       @default(0)
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, version])
  @@map("whatsapp_instructions")
}

model WhatsAppTemplate {
  id          String  @id @default(cuid())
  // Templates pertencem à WABA — cada número/WABA tem seu próprio catálogo.
  // Null = catálogo do número default (legado).
  numberId    String?
  name        String // nome aprovado na Meta
  language    String  @default("pt_BR")
  bodyVars    Int     @default(0)
  // Texto de referência com {{1}} {{2}}... só pra equipe saber o que digitar
  // em cada variável — não é enviado à Meta (ela já tem o template aprovado).
  bodyPreview String?
  // Ciclo de vida na Meta (03/08/2026): antes só existiam os APPROVED aqui,
  // porque a sincronização descartava o resto — quem criava um template não
  // tinha como acompanhar a análise. Agora espelhamos todos os status.
  // APPROVED | PENDING | REJECTED | PAUSED | DISABLED
  status      String  @default("APPROVED")
  // UTILITY | MARKETING | AUTHENTICATION — a Meta exige na criação e reprova
  // quando o conteúdo não bate com a categoria escolhida.
  category    String  @default("UTILITY")
  // Motivo devolvido pela Meta quando status=REJECTED (para a equipe corrigir
  // e reenviar sem adivinhar).
  rejectedReason String?
  // Id do template na Graph API — chega na criação e no webhook de status.
  metaId      String?
  // Cabeçalho de TEXTO (a Meta permite no máx. 1 variável e 60 caracteres).
  // Cabeçalho de mídia (imagem/vídeo/documento) não é suportado aqui: exige
  // subir um arquivo de exemplo pela Resumable Upload API.
  headerText  String?
  footerText  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([numberId, name])
  @@map("whatsapp_templates")
}

model Botconversa {
  id        String    @id @default(cuid())
  nome      String
  evento    String
  telefone  String
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Discord {
  id        String    @id @default(cuid())
  message   String
  channelId String
  executeAt DateTime
  sent      Boolean   @default(false)
  nome      String?
  telefone  String?
  evento    String?
  hours     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  firstSent Boolean   @default(false)

  @@map("discord")
}

model WorkSession {
  id         String    @id @default(cuid())
  userId     String
  discordId  String
  date       String
  startedAt  DateTime?
  // pausedAt/resumedAt são o par legado (uma pausa só por dia). Continuam
  // gravados como espelho da PRIMEIRA pausa; a fonte de verdade é `breaks`.
  pausedAt   DateTime?
  resumedAt  DateTime?
  finishedAt DateTime?
  isActive   Boolean   @default(false)
  isPaused   Boolean   @default(false)
  // Lista de pausas do dia: [{ start, end|null, kind: "almoco"|"pausa" }]
  breaks     Json?
  // Justificativa do colaborador ou do gestor (correção de esquecimento etc).
  note       String?
  // Turno que virou o dia aberto e foi fechado pelo sistema na virada.
  autoClosed Boolean   @default(false)
  // Auditoria da correção manual feita por quem tem `manage_ponto`.
  editedById String?
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([discordId, date])
  @@index([date])
  @@index([userId, date])
}

model AdminChecklistItem {
  id        String   @id @default(cuid())
  processId String?
  userId    String?
  text      String
  // Agrupamento visual (COMERCIAL, ADM, MÉDICO…). Null = grupo "Outros".
  section   String?
  checked   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processId])
  @@index([userId])
  @@map("admin_checklist_items")
}

model Instruction {
  id          String            @id @default(cuid())
  title       String
  description String?
  text        String?
  color       String            @default("amber")
  tags        String[]          @default([])
  folderName  String            @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  files       InstructionFile[]

  @@map("instructions")
}

model InstructionFile {
  id            String      @id @default(cuid())
  instructionId String
  name          String
  key           String
  size          String?
  type          String?
  uploadedAt    DateTime    @default(now())
  instruction   Instruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)

  @@index([instructionId])
  @@map("instruction_files")
}

model DevTicket {
  id           String    @id @default(cuid())
  title        String
  description  String
  // BUG | ALTERACAO | MELHORIA | OUTRO
  type         String    @default("BUG")
  // Fluxo: EM_DISTRIBUICAO -> EM_ANALISE -> EM_DESENVOLVIMENTO -> CONCLUIDO
  status       String    @default("EM_DISTRIBUICAO")
  // Print/foto opcional do problema (chave no S3, prefixo dev-tickets/).
  imageKey     String?
  imageName    String?
  creatorId    String
  creatorName  String
  // Dev que assumiu o ticket (null = aguardando em distribuição).
  assigneeId   String?
  assigneeName String?
  concludedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([assigneeId])
  @@map("dev_tickets")
}

// Custos de infraestrutura do projeto (Vercel, Neon, Claude, Railway, AWS...).
// Lançamento MANUAL: a equipe registra o que foi cobrado e em que dia — não há
// integração com as faturas dos provedores.
//
// Dinheiro em CENTAVOS (Int): Float arredonda errado em soma, e o Decimal do
// Prisma não atravessa a fronteira de server action sem serializador próprio.
//
// Dois valores porque a maioria destes serviços cobra em dólar mas a fatura do
// cartão chega em real: `amountCents` guarda o valor na moeda de origem (o que
// o provedor mostra) e `amountBrlCents` o valor consolidado em real — é este
// que soma nos totais e gráficos. Quando currency = BRL, os dois são iguais.
model ProjectCost {
  id             String   @id @default(cuid())
  // Chave do serviço (vercel, neon, claude, ...) — ver SERVICES em _actions/costs.
  service        String
  // Do que foi a cobrança: "Plano Pro", "créditos de API", "S3 + SES"...
  description    String?
  chargedAt      DateTime
  amountCents    Int
  currency       String   @default("BRL") // BRL | USD
  amountBrlCents Int
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([chargedAt])
  @@index([service])
  @@map("project_costs")
}
